rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helper Functions
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isUser() {
      return hasRole("USER");
    }

    function isVerifier() {
      return hasRole("VERIFIER");
    }

    function isAdmin() {
      return hasRole("ADMIN");
    }

    function isOwnerOrAdmin(userId) {
      return isOwner(userId) || isAdmin();
    }

    // ============================================================
    // Collection: users
    // ============================================================
    // USER: Read & Write own profile
    // VERIFIER: Read only
    // ADMIN: Full access

    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwnerOrAdmin(userId);

      // Users can create their own profile during registration
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(["uid", "email", "fullName", "role", "createdAt", "updatedAt"])
        && request.resource.data.role in ["USER", "VERIFIER", "ADMIN"]
        && request.resource.data.uid == userId;

      // Users can update their own profile (limited fields)
      allow update: if isOwnerOrAdmin(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["uid", "role", "createdAt"]);

      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // ============================================================
    // Collection: user_eco_summaries
    // ============================================================
    // USER: Read only (own summary)
    // VERIFIER: Read only
    // ADMIN: Full access
    // Client Direct Write: NO (Server/Admin SDK only)

    match /user_eco_summaries/{userId} {
      allow read: if isOwnerOrAdmin(userId);
      allow write: if isAdmin();
    }

    // ============================================================
    // Collection: waste_categories
    // ============================================================
    // USER: Read only
    // VERIFIER: Read only
    // ADMIN: Full access
    // Client Direct Write: NO (Admin only)

    match /waste_categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================
    // Collection: waste_transactions
    // ============================================================
    // USER: Read own, Create draft (PENDING only)
    // VERIFIER: Read all, Update status (verify/reject)
    // ADMIN: Full access
    // Client Direct Write: Conditional (PENDING draft only)

    match /waste_transactions/{transactionId} {
      // Users can read their own transactions
      // Verifiers and admins can read all
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid
        || isVerifier()
        || isAdmin()
      );

      // Users can create new transactions (draft/PENDING only)
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "PENDING"
        && request.resource.data.keys().hasAll([
          "userId", "status", "categoryId", "subCategoryId",
          "inputQuantity", "inputUnit", "estimatedCo2eSaved",
          "photoProofUrl", "pickupMethod", "createdAt"
        ]);

      // Verifiers can update status and add verification data
      // Admins can update anything
      allow update: if isAuthenticated() && (
        (isVerifier() && request.resource.data.status in ["VERIFIED", "REJECTED", "ADJUSTED"])
        || isAdmin()
      );

      // Only admins can delete transactions
      allow delete: if isAdmin();
    }

    // ============================================================
    // Collection: eco_point_redemptions
    // ============================================================
    // USER: Read only (own redemptions)
    // VERIFIER: No access
    // ADMIN: Full access
    // Client Direct Write: NO (Server/Admin SDK only)

    match /eco_point_redemptions/{redemptionId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid
        || isAdmin()
      );
      allow write: if isAdmin();
    }

    // ============================================================
    // Collection: audit_logs
    // ============================================================
    // All client roles: No access (System Internal only)

    match /audit_logs/{logId} {
      allow read, write: if false;
    }
  }
}
