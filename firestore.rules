rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helper Functions
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasRole(role) {
      return isAuthenticated() && getRole() == role;
    }

    function isCustomer() { return hasRole("customer"); }
    function isCollector() { return hasRole("collector"); }
    function isBankSampah() { return hasRole("bank_sampah"); }
    function isUMKM() { return hasRole("umkm"); }
    function isAdmin() { return hasRole("admin"); }

    function isOwnerOrAdmin(userId) {
      return isOwner(userId) || isAdmin();
    }

    // ============================================================
    // users — authenticated users can read for display purposes
    // ============================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwnerOrAdmin(userId);
      allow delete: if isAdmin();
    }

    // ============================================================
    // user_eco_summaries
    // ============================================================
    match /user_eco_summaries/{userId} {
      allow read: if isOwnerOrAdmin(userId);
      allow create: if isOwner(userId);
      allow write: if isAdmin();
    }

    // ============================================================
    // waste_categories
    // ============================================================
    match /waste_categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================
    // waste_transactions
    // ============================================================
    match /waste_transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ============================================================
    // pickups
    // ============================================================
    match /pickups/{pickupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
    }

    // ============================================================
    // pickup_events
    // ============================================================
    match /pickup_events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ============================================================
    // collectors
    // ============================================================
    match /collectors/{collectorId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(collectorId) || isAdmin();
    }

    // ============================================================
    // collector_locations
    // ============================================================
    match /collector_locations/{locationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ============================================================
    // collector_earnings
    // ============================================================
    match /collector_earnings/{earningId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(resource.data.collectorId) || isAdmin();
      allow update: if isAdmin();
    }

    // ============================================================
    // waste_banks
    // ============================================================
    match /waste_banks/{bankId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(bankId) || isAdmin();
    }

    // ============================================================
    // waste_bank_settlements
    // ============================================================
    match /waste_bank_settlements/{settlementId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
    }

    // ============================================================
    // wallets — owner can read, system creates, admin writes
    // ============================================================
    match /wallets/{walletId} {
      allow read: if isOwnerOrAdmin(walletId);
      allow create: if isOwner(walletId);
      allow update: if isOwnerOrAdmin(walletId);
    }

    // ============================================================
    // wallet_transactions — owner can read & create (cashout, spending)
    // ============================================================
    match /wallet_transactions/{txnId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ============================================================
    // cashout_requests — owner can create and read own
    // ============================================================
    match /cashout_requests/{requestId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
    }

    // ============================================================
    // eco_points — eco points ledger (earning & redemption)
    // ============================================================
    match /eco_points/{entryId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ============================================================
    // eco_point_redemptions
    // ============================================================
    match /eco_point_redemptions/{redemptionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================
    // marketplace_products
    // ============================================================
    match /marketplace_products/{productId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // ============================================================
    // marketplace_orders
    // ============================================================
    match /marketplace_orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
    }

    // ============================================================
    // disputes
    // ============================================================
    match /disputes/{disputeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() || isAdmin();
    }

    // ============================================================
    // fraud_flags
    // ============================================================
    match /fraud_flags/{flagId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
    }

    // ============================================================
    // notifications
    // ============================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // ============================================================
    // pricing_configs
    // ============================================================
    match /pricing_configs/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================
    // matching_configs
    // ============================================================
    match /matching_configs/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================
    // carbon_factors
    // ============================================================
    match /carbon_factors/{factorId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================
    // audit_logs — IMMUTABLE but allow authenticated create for own
    // ============================================================
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ============================================================
    // bank_capacity — daily capacity tracking per bank
    // ============================================================
    match /bank_capacity/{capacityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
    }

    // ============================================================
    // configs (system config)
    // ============================================================
    match /configs/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================
    // fcm_tokens
    // ============================================================
    match /fcm_tokens/{tokenDocId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ============================================================
    // regions
    // ============================================================
    match /regions/{regionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================
    // materials (alias for waste_categories in seed)
    // ============================================================
    match /materials/{materialId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
